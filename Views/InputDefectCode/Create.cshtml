@{
    ViewData["Title"] = "Thêm mã lỗi";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DefectManagement</title>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
            background: #f4f4f5;
            color: #09090b;
            padding: 24px;
        }
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 1100px;
            margin: 0 auto 20px;
        }
        .page-header h1 {
            font-size: 20px;
            font-weight: 800;
            margin: 0;
        }
        .btn-logout {
            border: 1px solid #e4e4e7;
            background: #fff;
            color: #3f3f46;
            font-size: 13px;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
        }
        .btn-logout:hover { border-color: #dc2626; color: #dc2626; }
        .card {
            max-width: 1100px;
            margin: 0 auto;
            background: #fff;
            border: 1px solid #e4e4e7;
            border-radius: 12px;
            padding: 24px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 8px;
            border-bottom: 1px solid #e4e4e7;
            text-align: left;
            font-size: 13px;
        }
        th {
            color: #71717a;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: .4px;
        }
        .form-control {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid #e4e4e7;
            border-radius: 6px;
            font-size: 13px;
        }
        .form-control.invalid {
            border-color: #dc2626;
            background: #fef2f2;
        }
        .form-control[readonly] {
            background: #f4f4f5;
            color: #71717a;
        }
        .col-code { width: 110px; }
        .col-priority { width: 100px; }
        .col-stt { width: 40px; text-align: center; }
        .col-remove { width: 60px; text-align: center; }
        .col-actions { width: 140px; }
        .table-scroll {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .table-scroll table { min-width: 640px; }
        .btn-remove-row {
            border: none;
            background: transparent;
            color: #dc2626;
            font-size: 18px;
            cursor: pointer;
            line-height: 1;
        }
        .btn-remove-row:disabled { color: #d4d4d8; cursor: not-allowed; }
        .actions-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
        }
        .btn-add-row {
            border: 1px dashed #2a5298;
            background: #ebf0fb;
            color: #2a5298;
            font-weight: 700;
            font-size: 13px;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
        }
        .btn-save {
            border: none;
            background: #dc2626;
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
        }
        .btn-save:disabled { background: #f4a7a7; cursor: not-allowed; }
        .hint {
            font-size: 12px;
            color: #71717a;
            margin-top: 4px;
        }
        .alert-box {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
            display: none;
        }
        .alert-box.success { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; display: block; }
        .alert-box.error { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; display: block; }

        .tabs {
            max-width: 1100px;
            margin: 0 auto 16px;
            display: flex;
            gap: 8px;
        }
        .tab-btn {
            border: 1px solid #e4e4e7;
            background: #fff;
            color: #3f3f46;
            font-size: 13px;
            font-weight: 700;
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
        }
        .tab-btn.active {
            background: #dc2626;
            border-color: #dc2626;
            color: #fff;
        }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        .btn-small {
            border: none;
            font-size: 12px;
            font-weight: 700;
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            margin-right: 4px;
        }
        .btn-edit { background: #ebf0fb; color: #2a5298; }
        .btn-delete { background: #fef2f2; color: #dc2626; }
        .btn-cancel { background: #f4f4f5; color: #3f3f46; }
        .empty-state {
            text-align: center;
            color: #71717a;
            font-size: 13px;
            padding: 20px 0;
        }

        .select2-container { width: 100% !important; }
        .select2-container .select2-selection--single {
            height: 34px;
            padding: 8px 10px;
            border: 1px solid #e4e4e7;
            border-radius: 6px;
        }
        .select2-container .select2-selection--single .select2-selection__rendered {
            line-height: 16px;
            padding: 0;
            font-size: 13px;
        }
        .select2-container .select2-selection--single .select2-selection__arrow {
            height: 32px;
        }
        .select2-selection.invalid {
            border-color: #dc2626 !important;
            background: #fef2f2;
        }

        /* ===== RESPONSIVE (mobile) ===== */
        @@media (max-width: 640px) {
            body { padding: 12px; }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
            .page-header h1 { font-size: 17px; }
            .btn-logout { width: 100%; }

            .tabs {
                flex-wrap: wrap;
            }
            .tab-btn {
                flex: 1 1 auto;
                text-align: center;
                padding: 10px 12px;
            }

            .card { padding: 14px; }

            .actions-bar {
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }
            .btn-add-row, .btn-save {
                width: 100%;
                text-align: center;
            }

            .table-scroll table { min-width: 560px; }
        }
    </style>
</head>
<body>
    <div class="page-header">
        <h1>Thêm mã lỗi</h1>
        <form method="post" asp-action="Logout" asp-controller="InputDefectCode">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout">Đăng xuất</button>
        </form>
    </div>

    <div class="tabs">
        <button type="button" class="tab-btn active" id="tabBtnAdd">Thêm mới</button>
        <button type="button" class="tab-btn" id="tabBtnEdit">Chỉnh sửa dữ liệu</button>
    </div>

    <div class="card tab-panel active" id="tabPanelAdd">
        <div id="alertBox" class="alert-box"></div>

        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th class="col-stt">#</th>
                        <th>Tên lỗi</th>
                        <th class="col-code">Code</th>
                        <th class="col-priority">Priority</th>
                        <th>Operation</th>
                        <th class="col-remove"></th>
                    </tr>
                </thead>
                <tbody id="rowsBody"></tbody>
            </table>
        </div>

        <div class="actions-bar">
            <button type="button" class="btn-add-row" id="btnAddRow">+ Thêm dòng</button>
            <button type="button" class="btn-save" id="btnSave">Lưu tất cả</button>
        </div>
        <div class="hint">Code được hệ thống tự sinh (không thể chỉnh sửa). Operation không được chứa khoảng trắng. Tất cả các trường đều bắt buộc.</div>
    </div>

    <div class="card tab-panel" id="tabPanelEdit">
        <div id="editAlertBox" class="alert-box"></div>

        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th class="col-stt">#</th>
                        <th class="col-code">Code</th>
                        <th>Tên lỗi</th>
                        <th class="col-priority">Priority</th>
                        <th>Operation</th>
                        <th class="col-actions">Hành động</th>
                    </tr>
                </thead>
                <tbody id="editRowsBody"></tbody>
            </table>
        </div>
        <div class="hint">Không thể chỉnh sửa Code (mã tự sinh). Operation không được chứa khoảng trắng, tất cả các trường đều bắt buộc.</div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        // ============ Dropdown Tên lỗi (tìm kiếm + thêm mới, không trùng lặp) ============
        let allNames = [];

        async function loadAllNames() {
            try {
                const res = await fetch('/InputDefectCode/GetDistinctNames');
                allNames = res.ok ? await res.json() : [];
            } catch (err) {
                allNames = [];
            }
        }

        function escapeHtml(str) {
            return String(str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function buildNameOptionsHtml(selectedValue) {
            let hasSelected = false;
            let html = '<option value=""></option>';

            allNames.forEach(n => {
                const isSelected = n === selectedValue;
                if (isSelected) hasSelected = true;
                html += `<option value="${escapeHtml(n)}"${isSelected ? ' selected' : ''}>${escapeHtml(n)}</option>`;
            });

            if (selectedValue && !hasSelected) {
                html += `<option value="${escapeHtml(selectedValue)}" selected>${escapeHtml(selectedValue)}</option>`;
            }

            return html;
        }

        function initNameSelect2(selectEl) {
            $(selectEl).select2({
                placeholder: 'Chọn hoặc nhập tên lỗi mới...',
                allowClear: true,
                width: '100%',
                tags: true,
                language: {
                    noResults: function () { return 'Không tìm thấy, gõ để thêm mới'; },
                    searching: function () { return 'Đang tìm kiếm...'; }
                }
            });
        }

        function setNameSelectInvalid(selectEl, invalid) {
            const container = $(selectEl).next('.select2-container').find('.select2-selection');
            container.toggleClass('invalid', invalid);
        }

        const baseCodeNumber = (function () {
            const preview = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.NextCodePreview));
            const match = /^R(\d+)$/i.exec(preview);
            return match ? parseInt(match[1], 10) : 1;
        })();

        const rowsBody = document.getElementById('rowsBody');
        const alertBox = document.getElementById('alertBox');

        function showAlert(message, type) {
            alertBox.textContent = message;
            alertBox.className = 'alert-box ' + type;
        }

        function hideAlert() {
            alertBox.className = 'alert-box';
            alertBox.textContent = '';
        }

        function renumberRows() {
            const trs = rowsBody.querySelectorAll('tr');
            trs.forEach((tr, idx) => {
                tr.querySelector('.cell-stt').textContent = idx + 1;
                tr.querySelector('.cell-code').value = 'R' + (baseCodeNumber + idx);
                tr.querySelector('.btn-remove-row').disabled = trs.length === 1;
            });
        }

        function addRow() {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="col-stt cell-stt"></td>
                <td><select class="form-control cell-name">${buildNameOptionsHtml('')}</select></td>
                <td class="col-code"><input type="text" class="form-control cell-code" readonly /></td>
                <td class="col-priority"><input type="number" class="form-control cell-priority" min="0" placeholder="0" /></td>
                <td><input type="text" class="form-control cell-operation" placeholder="Không chứa khoảng trắng..." /></td>
                <td class="col-remove"><button type="button" class="btn-remove-row" title="Xóa dòng">&times;</button></td>
            `;
            rowsBody.appendChild(tr);

            initNameSelect2(tr.querySelector('.cell-name'));

            const opInput = tr.querySelector('.cell-operation');
            opInput.addEventListener('input', function () {
                if (/\s/.test(this.value)) {
                    this.value = this.value.replace(/\s/g, '');
                }
            });

            tr.querySelector('.btn-remove-row').addEventListener('click', function () {
                if (rowsBody.querySelectorAll('tr').length === 1) return;
                tr.remove();
                renumberRows();
            });

            renumberRows();
        }

        document.getElementById('btnAddRow').addEventListener('click', addRow);

        function clearInvalid(el) {
            el.classList.remove('invalid');
        }

        function collectAndValidateRows() {
            const trs = Array.from(rowsBody.querySelectorAll('tr'));
            const rows = [];
            let isValid = true;

            trs.forEach(tr => {
                const nameEl = tr.querySelector('.cell-name');
                const priorityEl = tr.querySelector('.cell-priority');
                const operationEl = tr.querySelector('.cell-operation');

                clearInvalid(priorityEl);
                clearInvalid(operationEl);
                setNameSelectInvalid(nameEl, false);

                const name = (nameEl.value || '').trim();
                const priorityRaw = priorityEl.value.trim();
                const operation = operationEl.value.trim();

                if (!name) { setNameSelectInvalid(nameEl, true); isValid = false; }
                if (priorityRaw === '') { priorityEl.classList.add('invalid'); isValid = false; }
                if (!operation) { operationEl.classList.add('invalid'); isValid = false; }
                if (operation && /\s/.test(operation)) { operationEl.classList.add('invalid'); isValid = false; }

                rows.push({
                    Name: name,
                    Priority: priorityRaw === '' ? null : parseInt(priorityRaw, 10),
                    Operation: operation
                });
            });

            return { rows, isValid };
        }

        document.getElementById('btnSave').addEventListener('click', async function () {
            hideAlert();
            const { rows, isValid } = collectAndValidateRows();

            if (!isValid) {
                showAlert('Vui lòng điền đầy đủ thông tin bắt buộc và không để khoảng trắng trong Operation!', 'error');
                return;
            }

            const btn = this;
            btn.disabled = true;
            btn.textContent = 'Đang lưu...';

            try {
                const res = await fetch('/InputDefectCode/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(rows)
                });
                const data = await res.json();

                if (data.success) {
                    showAlert(data.message, 'success');
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    showAlert(data.message || 'Lưu thông tin không thành công!', 'error');
                }
            } catch (err) {
                showAlert('Có lỗi xảy ra khi lưu thông tin!', 'error');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Lưu tất cả';
            }
        });

        (async function initPage() {
            await loadAllNames();
            addRow();
        })();

        // ============ Tabs ============
        const tabBtnAdd = document.getElementById('tabBtnAdd');
        const tabBtnEdit = document.getElementById('tabBtnEdit');
        const tabPanelAdd = document.getElementById('tabPanelAdd');
        const tabPanelEdit = document.getElementById('tabPanelEdit');

        tabBtnAdd.addEventListener('click', async function () {
            tabBtnAdd.classList.add('active');
            tabBtnEdit.classList.remove('active');
            tabPanelAdd.classList.add('active');
            tabPanelEdit.classList.remove('active');
            await loadAllNames();
        });

        tabBtnEdit.addEventListener('click', async function () {
            tabBtnEdit.classList.add('active');
            tabBtnAdd.classList.remove('active');
            tabPanelEdit.classList.add('active');
            tabPanelAdd.classList.remove('active');
            await loadAllNames();
            loadEditList();
        });

        // ============ Chỉnh sửa dữ liệu ============
        const editRowsBody = document.getElementById('editRowsBody');
        const editAlertBox = document.getElementById('editAlertBox');
        let editData = [];

        function showEditAlert(message, type) {
            editAlertBox.textContent = message;
            editAlertBox.className = 'alert-box ' + type;
        }

        function hideEditAlert() {
            editAlertBox.className = 'alert-box';
            editAlertBox.textContent = '';
        }

        async function loadEditList() {
            hideEditAlert();
            editRowsBody.innerHTML = '<tr><td colspan="6" class="empty-state">Đang tải...</td></tr>';

            try {
                const res = await fetch('/InputDefectCode/GetList');
                if (!res.ok) throw new Error('load failed');
                editData = await res.json();
                renderEditList();
            } catch (err) {
                editRowsBody.innerHTML = '<tr><td colspan="6" class="empty-state">Không tải được dữ liệu!</td></tr>';
            }
        }

        function renderEditList() {
            if (!editData || editData.length === 0) {
                editRowsBody.innerHTML = '<tr><td colspan="6" class="empty-state">Chưa có dữ liệu.</td></tr>';
                return;
            }

            editRowsBody.innerHTML = '';
            editData.forEach((item, idx) => renderEditRow(item, idx));
        }

        function renderEditRow(item, idx) {
            const tr = document.createElement('tr');
            tr.dataset.id = item.id;
            tr.innerHTML = `
                <td class="col-stt">${idx + 1}</td>
                <td class="col-code">${item.code ?? ''}</td>
                <td class="view-name">${item.name ?? ''}</td>
                <td class="col-priority view-priority">${item.priority ?? ''}</td>
                <td class="view-operation">${item.operation ?? ''}</td>
                <td>
                    <button type="button" class="btn-small btn-edit" data-action="edit">Sửa</button>
                    <button type="button" class="btn-small btn-delete" data-action="delete">Xóa</button>
                </td>
            `;

            tr.querySelector('[data-action="edit"]').addEventListener('click', function () {
                switchRowToEditMode(tr, item);
            });
            tr.querySelector('[data-action="delete"]').addEventListener('click', function () {
                deleteRow(item.id, tr);
            });

            editRowsBody.appendChild(tr);
        }

        function switchRowToEditMode(tr, item) {
            tr.innerHTML = `
                <td class="col-stt">${tr.rowIndex}</td>
                <td class="col-code">${item.code ?? ''}</td>
                <td><select class="form-control edit-name">${buildNameOptionsHtml(item.name ?? '')}</select></td>
                <td class="col-priority"><input type="number" class="form-control edit-priority" min="0" value="${item.priority ?? ''}" /></td>
                <td><input type="text" class="form-control edit-operation" value="${(item.operation ?? '').replace(/"/g, '&quot;')}" /></td>
                <td>
                    <button type="button" class="btn-small btn-edit" data-action="save">Lưu</button>
                    <button type="button" class="btn-small btn-cancel" data-action="cancel">Hủy</button>
                </td>
            `;

            initNameSelect2(tr.querySelector('.edit-name'));

            const opInput = tr.querySelector('.edit-operation');
            opInput.addEventListener('input', function () {
                if (/\s/.test(this.value)) {
                    this.value = this.value.replace(/\s/g, '');
                }
            });

            tr.querySelector('[data-action="cancel"]').addEventListener('click', function () {
                renderEditList();
            });

            tr.querySelector('[data-action="save"]').addEventListener('click', function () {
                saveRow(item.id, tr);
            });
        }

        async function saveRow(id, tr) {
            hideEditAlert();

            const nameEl = tr.querySelector('.edit-name');
            const priorityEl = tr.querySelector('.edit-priority');
            const operationEl = tr.querySelector('.edit-operation');

            const name = (nameEl.value || '').trim();
            const priorityRaw = priorityEl.value.trim();
            const operation = operationEl.value.trim();

            [priorityEl, operationEl].forEach(el => el.classList.remove('invalid'));
            setNameSelectInvalid(nameEl, false);

            let isValid = true;
            if (!name) { setNameSelectInvalid(nameEl, true); isValid = false; }
            if (priorityRaw === '') { priorityEl.classList.add('invalid'); isValid = false; }
            if (!operation) { operationEl.classList.add('invalid'); isValid = false; }
            if (operation && /\s/.test(operation)) { operationEl.classList.add('invalid'); isValid = false; }

            if (!isValid) {
                showEditAlert('Vui lòng điền đầy đủ thông tin bắt buộc và không để khoảng trắng trong Operation!', 'error');
                return;
            }

            try {
                const res = await fetch('/InputDefectCode/Update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        Id: id,
                        Name: name,
                        Priority: parseInt(priorityRaw, 10),
                        Operation: operation
                    })
                });
                const data = await res.json();

                if (data.success) {
                    showEditAlert(data.message, 'success');
                    loadEditList();
                } else {
                    showEditAlert(data.message || 'Cập nhật không thành công!', 'error');
                }
            } catch (err) {
                showEditAlert('Có lỗi xảy ra khi cập nhật!', 'error');
            }
        }

        async function deleteRow(id, tr) {
            if (!confirm('Bạn có chắc muốn xóa bản ghi này?')) return;

            hideEditAlert();

            try {
                const res = await fetch('/InputDefectCode/Delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Id: id })
                });
                const data = await res.json();

                if (data.success) {
                    showEditAlert(data.message, 'success');
                    loadEditList();
                } else {
                    showEditAlert(data.message || 'Xóa không thành công!', 'error');
                }
            } catch (err) {
                showEditAlert('Có lỗi xảy ra khi xóa!', 'error');
            }
        }
    </script>
</body>
</html>
