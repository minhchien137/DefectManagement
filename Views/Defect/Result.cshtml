@model List<DefectManagement.Models.SVN_Defect_Record_History>
@{
    ViewData["Title"] = "Lịch sử nhập lỗi";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet">

    <style>
        /* ===== DESIGN SYSTEM ===== */
        :root {
            --brand: #dc2626;
            --brand-dark: #991b1b;
            --ink: #09090b;
            --ink-2: #3f3f46;
            --ink-3: #71717a;
            --surface: #ffffff;
            --base: #f4f4f5;
            --border: #e4e4e7;
        }

        /* ===== BASE ===== */
        *, *::before, *::after { box-sizing: border-box; }
        body {
            font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
            background-color: var(--base);
            font-size: 14px;
            color: var(--ink);
        }

        /* ===== PAGE TITLE ===== */
        .page-title-bar {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: .9rem 1.2rem .9rem 1.75rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 1px 2px rgba(0,0,0,.05);
            position: relative;
        }
        .page-title-bar::before {
            content: '';
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 4px;
            background: var(--brand);
            border-radius: 12px 0 0 12px;
        }

        /* ===== FILTER SECTION ===== */
        .filter-section {
            background: var(--surface);
            border: 1px solid var(--border) !important;
            border-radius: 12px !important;
            box-shadow: 0 1px 2px rgba(0,0,0,.05);
        }

        /* ===== CARD ===== */
        .card {
            border: 1px solid var(--border) !important;
            box-shadow: 0 1px 2px rgba(0,0,0,.05) !important;
            border-radius: 12px !important;
        }
        .card-header {
            background: var(--surface) !important;
            border-bottom: 1px solid var(--border) !important;
            font-size: 13px;
            font-weight: 700;
            color: var(--ink);
        }

        /* ===== TABLE ===== */
        .table thead th {
            background: var(--ink) !important;
            color: #fff !important;
            font-size: 11px !important;
            font-weight: 700 !important;
            text-transform: uppercase;
            letter-spacing: .5px;
            border-color: #1c1c1e !important;
        }
        .table tbody tr:hover { background-color: rgba(220,38,38,.06) !important; }
        .table td { font-size: 12px; color: var(--ink); border-color: var(--border); vertical-align: middle; }
        .table-striped tbody tr:nth-of-type(odd) { background-color: #fafafa; }

        /* ===== IMAGE PREVIEW ===== */
        .image-preview {
            max-width: 80px;
            max-height: 80px;
            border-radius: 6px;
            cursor: pointer;
            border: 1px solid var(--border);
            transition: transform .15s;
        }
        .image-preview:hover { transform: scale(1.15); }

        /* ===== FORM CONTROLS ===== */
        .form-control:focus, .form-select:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 .2rem rgba(220,38,38,.1);
        }
        .form-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--ink-3);
            margin-bottom: 4px;
        }

        /* ===== BUTTONS ===== */
        .btn-primary {
            background-color: var(--brand) !important;
            border-color: var(--brand) !important;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
        }
        .btn-primary:hover {
            background-color: var(--brand-dark) !important;
            border-color: var(--brand-dark) !important;
        }
        .btn-secondary {
            background-color: var(--ink-2) !important;
            border-color: var(--ink-2) !important;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
        }
        .btn-secondary:hover {
            background-color: var(--ink) !important;
            border-color: var(--ink) !important;
        }
        .btn-success {
            background-color: #16a34a !important;
            border-color: #16a34a !important;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
        }
        .btn-success:hover {
            background-color: #15803d !important;
            border-color: #15803d !important;
        }

        /* ===== NULL DISPLAY ===== */
        .text-null { color: var(--ink-3); font-style: italic; font-size: 11px; }

        /* ===== PAGINATION ===== */
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .pagination-info {
            font-size: 12px;
            color: var(--ink-3);
        }

        .custom-pagination .page-link {
            color: var(--ink-2);
            border-color: var(--border);
            padding: 6px 10px;
            font-size: 12px;
            min-width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: color .15s, border-color .15s;
        }

        .custom-pagination .page-item.active .page-link {
            background-color: var(--brand);
            border-color: var(--brand);
            color: #fff;
            font-weight: 700;
        }

        .custom-pagination .page-link:hover {
            color: var(--brand);
            background-color: #fff5f5;
            border-color: var(--brand);
        }

        .custom-pagination .page-link i { font-size: 11px; }
        .custom-pagination .page-item { margin: 0 1px; }

        /* ===== DATATABLES OVERRIDES ===== */
        .dataTables_wrapper .dataTables_filter input:focus,
        .dataTables_wrapper .dataTables_length select:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 .2rem rgba(220,38,38,.1);
            outline: none;
        }
        .dataTables_paginate .paginate_button.current,
        .dataTables_paginate .paginate_button.current:hover {
            background: var(--brand) !important;
            border-color: var(--brand) !important;
            color: #fff !important;
        }
        .dataTables_paginate .paginate_button:hover {
            background: #fff5f5 !important;
            border-color: var(--brand) !important;
            color: var(--brand) !important;
        }

        /* ===== MODAL ===== */
        .modal-header {
            border-bottom: 1px solid var(--border);
        }

        /* ===== DATATABLES SORT ICONS ON BLACK HEADER ===== */
        table.dataTable thead th::before,
        table.dataTable thead th::after {
            color: rgba(255,255,255,.5) !important;
        }
        table.dataTable thead th.sorting_asc::before,
        table.dataTable thead th.sorting_desc::after {
            color: #fff !important;
            opacity: 1 !important;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 768px) {
            a[style*="margin-left: 9px"] {
                margin-left: 0 !important;
                margin-top: 0 !important;
            }
            .row.mt-3 .col-12 {
                display: flex;
                flex-wrap: nowrap;
                gap: 8px;
                justify-content: flex-start;
                align-items: center;
            }
            .row.mt-3 .col-12 .btn {
                flex: 1;
                min-width: 80px;
                margin: 0;
                font-size: 11px;
                padding: 6px 8px;
            }
            .pagination-container {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
                gap: 12px;
            }
            .custom-pagination {
                justify-content: center;
                flex-wrap: wrap;
            }
            .custom-pagination .page-link {
                padding: 5px 8px;
                font-size: 11px;
                min-width: 28px;
                height: 28px;
            }
            .pagination-info { font-size: 11px; }
        }
    </style>
</head>

<body>
<div class="container-fluid mt-4">
    <!-- Page Header -->
    <div class="page-title-bar mb-4">
        <h5 style="margin:0; font-weight:800; letter-spacing:-.3px; color:#09090b; font-size:1.1rem;">Lịch sử nhập lỗi</h5>
    </div>
    <!-- Bộ lọc tìm kiếm -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card filter-section">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-search me-2"></i>Tìm kiếm</h5>
                </div>
                <div class="card-body">
                    <form method="get" action="@Url.Action("Result", "Defect")">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Work Order:</label>
                                <input type="text" class="form-control" name="workOrder" value="@ViewBag.WorkOrder"
                                       placeholder="Nhập Work Order...">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Defect Code:</label>
                                <input type="text" class="form-control" name="defectCode" value="@ViewBag.DefectCode"
                                       placeholder="Nhập Defect Code...">       
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Defect Name:</label>
                                <input type="text" class="form-control" name="defectName" value="@ViewBag.DefectName"
                                       placeholder="Nhập Defect Name...">
                            </div>
                            
                            <div class="col-md-3">
                                <label class="form-label">Operation:</label>
                                <input type="text" class="form-control" name="operation" value="@ViewBag.Operation"
                                    placeholder="Nhập Operation">
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Employer Code:</label>
                                <input type="text" class="form-control" name="employerCode" value="@ViewBag.EmployerCode"
                                       placeholder="Nhập Employer Code...">
                            </div>
                            
                             <div class="col-md-3">
                                <label class="form-label">From:</label>
                                <input type="date" class="form-control" name="fromInsDateTime" value="@ViewBag.FromInsDateTime" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">To:</label>
                                <input type="date" class="form-control" name="toInsDateTime" value="@ViewBag.ToInsDateTime" />
                            </div>

                            <div class="col-md-3">
                               <label class="form-label">Số bản ghi/trang:</label>
                                <select class="form-control" name="pageSize" id="pageSizeSelect" onchange="document.getElementById('searchForm').submit();">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fas fa-search me-1"></i>Tìm kiếm
                                </button>
                                <a href="@Url.Action("Result", "Defect")" class="btn btn-secondary">
                                    <i class="fas fa-refresh me-1"></i>Xóa bộ lọc
                                </a>

                                 <a style="margin-left: 9px;" href="@Url.Action("ExportToExcel", "Defect", new { 
                                    workOrder = @ViewBag.WorkOrder, 
                                    defectCode = @ViewBag.DefectCode,
                                    defectName = @ViewBag.DefectName,
                                    employerCode = @ViewBag.EmployerCode, 
                                    operation = @ViewBag.Operation,
                                    fromInsDateTime = @ViewBag.FromInsDateTime,
                                    toInsDateTime = @ViewBag.ToInsDateTime
        
                                })" class="btn btn-success">
                                    <i class="fas fa-file-excel me-1"></i>Xuất Excel
                                </a>
                            </div>
                        </div>
                        <input type="hidden" name="page" value="1" id="pageInput">
                    </form>
                </div>
            </div>
        </div>
    </div>

  
    <!-- Bảng dữ liệu -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-table me-2"></i>Defect Records List</h5>
                    @if (ViewBag.TotalRecords != null && ViewBag.TotalRecords > 0)
                    {
                        <small class="text-muted">
                            Tổng: <strong>@ViewBag.TotalRecords</strong> bản ghi
                        </small>
                    }
                </div>
                <div class="card-body">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="defectTable">
                                <thead>
                                <tr>
                                    <th>Work Order</th>
                                    <th>Item Code</th>
                                    <th>Defect Code</th>
                                    <th>Defect Name</th>
                                    <th>Qty NG</th>
                                    <th>Operation</th>
                                    <th>Employer Code</th>
                                    <th>Employer Name</th>
                                    <th>Note</th>
                                    <th>Image</th>
                                    <th>Time Line</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(item.Work_order) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Work_order)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Item_code) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Item_code)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Defect_Code) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Defect_Code)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Defect_Name) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Defect_Name)</td>
                                        <td>@(item.Qty_NG?.ToString() ?? Html.Raw("<span class='text-null'>NULL</span>").ToString())</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Operation) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Operation)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Employer_code) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Employer_code)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Employer_name) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Employer_name)</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.Note))
                                            {
                                                <span class="text-truncate d-inline-block" style="max-width: 150px;" title="@item.Note">
                                                    @item.Note
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-null">NULL</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.Image_error))
                                            {
                                                <img src="@item.Image_error" class="image-preview" alt="Error Image"
                                                     onclick="showImageModal('@item.Image_error')" />
                                            }
                                            else
                                            {
                                                <span class="text-null">NULL</span>
                                            }
                                        </td>
                                        <td>
                                            @(item.Time_line.HasValue
                                                ? item.Time_line.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                                : Html.Raw("<span class='text-null'>NULL</span>"))
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
                        {
                            <div class="pagination-container">
                                <div class="pagination-info">
                                    Hiển thị @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1) - @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalRecords)) 
                                    trong tổng số @ViewBag.TotalRecords bản ghi
                                </div>
                                
                                <nav aria-label="Pagination">
                                    <ul class="pagination custom-pagination mb-0">
                                        @if (ViewBag.HasPreviousPage)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@GetPageUrl(1)">
                                                    <i class="fas fa-angle-double-left"></i>
                                                </a>
                                            </li>
                                            <li class="page-item">
                                                <a class="page-link" href="@GetPageUrl(ViewBag.CurrentPage - 1)">
                                                    <i class="fas fa-angle-left"></i>
                                                </a>
                                            </li>
                                        }

                                        @{
                                            int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                                            int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);
                                        }

                                        @for (int i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                <a class="page-link" href="@GetPageUrl(i)">@i</a>
                                            </li>
                                        }

                                        @if (ViewBag.HasNextPage)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@GetPageUrl(ViewBag.CurrentPage + 1)">
                                                    <i class="fas fa-angle-right"></i>
                                                </a>
                                            </li>
                                            <li class="page-item">
                                                <a class="page-link" href="@GetPageUrl(ViewBag.TotalPages)">
                                                    <i class="fas fa-angle-double-right"></i>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>
                            Không có dữ liệu để hiển thị. Vui lòng thử lại với bộ lọc khác.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal hiển thị ảnh -->
<div class="modal fade" id="imageModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xem ảnh lỗi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid" style="max-height: 500px;" />
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#defectTable').DataTable({
            responsive: true,
            pageLength: 25,
            order: [[11, 'desc']], // Sort by Time_line desc
            language: {
                search: "Tìm kiếm:",
                lengthMenu: "Hiển thị _MENU_ bản ghi",
                info: "Hiển thị _START_ đến _END_ trong tổng số _TOTAL_ bản ghi",
                infoEmpty: "Hiển thị 0 đến 0 trong tổng số 0 bản ghi",
                infoFiltered: "(được lọc từ _MAX_ bản ghi)",
                paginate: { first: "Đầu", last: "Cuối", next: "Tiếp", previous: "Trước" },
                emptyTable: "Không có dữ liệu trong bảng"
            },
            columnDefs: [
                { targets: [10], orderable: false } // Image column không sort được
            ]
        });
    });


    document.addEventListener('DOMContentLoaded', function() {
        var currentPageSize = @(ViewBag.PageSize ?? 25);
        var selectElement = document.getElementById('pageSizeSelect');
        if (selectElement) {
            selectElement.value = currentPageSize;
        }
    });


    function showImageModal(imageSrc) {
        $('#modalImage').attr('src', imageSrc);
        $('#imageModal').modal('show');
    }


     @functions {
        private string GetPageUrl(int page)
        {
            var routeValues = new Dictionary<string, object>
            {
                { "page", page },
                { "pageSize", ViewBag.PageSize ?? 25 },
                { "workOrder", ViewBag.WorkOrder ?? "" },
                { "defectCode", ViewBag.DefectCode ?? "" },
                { "defectName", ViewBag.DefectName ?? "" },
                { "employerCode", ViewBag.EmployerCode ?? "" },
                { "operation", ViewBag.Operation ?? "" },
                { "fromInsDateTime", ViewBag.FromInsDateTime ?? "" },
                { "toInsDateTime", ViewBag.ToInsDateTime ?? "" }
            };
            
            return Url.Action("Result", "Defect", routeValues);
        }
    }

</script>
</body>
</html>