@model List<DefectManagement.Models.SVN_Defect_Record_History>
@{
    ViewData["Title"] = "Danh sách Defect Records";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet">

    <style>
        .filter-section { background-color: #f8f9fa; border-radius: 10px; border: 1px solid #dee2e6; }
        .card { border: none; box-shadow: 0 2px 4px rgba(0,0,0,.1); border-radius: 10px; }
        .table thead th { background-color: #ff3b45; color: #fff; font-weight: 600; }
        .table tbody tr:hover { background-color: #f1f3f4; }
        .image-preview { max-width: 80px; max-height: 80px; border-radius: 5px; cursor: pointer; }
        .form-control:focus { border-color: #ff3b45; box-shadow: 0 0 0 .2rem rgba(73,80,87,.25); }
        .btn-primary { background-color: #ff3b45; border-color: #ff3b45; }
        .btn-primary:hover { background-color: #ff3b45; border-color: #ff3b45; }
        .text-null { color: #ff3b45; font-style: #ff3b45; }
    </style>
</head>

<body>
<div class="container-fluid mt-4">
    <!-- Bộ lọc tìm kiếm -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card filter-section">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-search me-2"></i>Tìm kiếm</h5>
                </div>
                <div class="card-body">
                    <form method="get" action="@Url.Action("Result", "Defect")">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Work Order:</label>
                                <input type="text" class="form-control" name="workOrder" value="@ViewBag.WorkOrder"
                                       placeholder="Nhập Work Order...">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Item Code:</label>
                                <input type="text" class="form-control" name="itemCode" value="@ViewBag.ItemCode"
                                       placeholder="Nhập Item Code...">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Employer Code:</label>
                                <input type="text" class="form-control" name="employerCode" value="@ViewBag.EmployerCode"
                                       placeholder="Nhập Employer Code...">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">INS DateTime:</label>
                                <input type="text" class="form-control" name="insDateTime" value="@ViewBag.InsDateTime"
                                       placeholder="Nhập INS DateTime...">
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fas fa-search me-1"></i>Tìm kiếm
                                </button>
                                <a href="@Url.Action("Result", "Defect")" class="btn btn-secondary">
                                    <i class="fas fa-refresh me-1"></i>Xóa bộ lọc
                                </a>

                                 <a href="@Url.Action("ExportToExcel", "Defect", new { 
                                    workOrder = ViewBag.WorkOrder, 
                                    itemCode = ViewBag.ItemCode, 
                                    employerCode = ViewBag.EmployerCode, 
                                    insDateTime = ViewBag.InsDateTime 
                                })" class="btn btn-success">
                                    <i class="fas fa-file-excel me-1"></i>Xuất Excel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-table me-2"></i>Danh sách Defect Records</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="defectTable">
                                <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Work Order</th>
                                    <th>Item Code</th>
                                    <th>Defect Code</th>
                                    <th>Qty NG</th>
                                    <th>INS DateTime</th>
                                    <th>Operation</th>
                                    <th>Employer Code</th>
                                    <th>Employer Name</th>
                                    <th>Note</th>
                                    <th>Image</th>
                                    <th>Time Line</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Work_order) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Work_order)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Item_code) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Item_code)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Defect_Code) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Defect_Code)</td>

                                        <!-- Qty_NG nullable -->
                                        <td>@(item.Qty_NG?.ToString() ?? Html.Raw("<span class='text-null'>NULL</span>").ToString())</td>

                                        <td>@(string.IsNullOrWhiteSpace(item.INSDatetime) ? Html.Raw("<span class='text-null'>NULL</span>") : item.INSDatetime)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Operation) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Operation)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Employer_code) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Employer_code)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Employer_name) ? Html.Raw("<span class='text-null'>NULL</span>") : item.Employer_name)</td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.Note))
                                            {
                                                <span class="text-truncate d-inline-block" style="max-width: 150px;" title="@item.Note">
                                                    @item.Note
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-null">NULL</span>
                                            }
                                        </td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.Image_error))
                                            {
                                                <img src="@item.Image_error" class="image-preview" alt="Error Image"
                                                     onclick="showImageModal('@item.Image_error')" />
                                            }
                                            else
                                            {
                                                <span class="text-null">NULL</span>
                                            }
                                        </td>

                                        <!-- Time_line nullable + định dạng -->
                                        <td>
                                            @(item.Time_line.HasValue
                                                ? item.Time_line.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                                : Html.Raw("<span class='text-null'>NULL</span>"))
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>
                            Không có dữ liệu để hiển thị. Vui lòng thử lại với bộ lọc khác.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal hiển thị ảnh -->
<div class="modal fade" id="imageModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xem ảnh lỗi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid" style="max-height: 500px;" />
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#defectTable').DataTable({
            responsive: true,
            pageLength: 25,
            order: [[11, 'desc']], // Sort by Time_line desc
            language: {
                search: "Tìm kiếm:",
                lengthMenu: "Hiển thị _MENU_ bản ghi",
                info: "Hiển thị _START_ đến _END_ trong tổng số _TOTAL_ bản ghi",
                infoEmpty: "Hiển thị 0 đến 0 trong tổng số 0 bản ghi",
                infoFiltered: "(được lọc từ _MAX_ bản ghi)",
                paginate: { first: "Đầu", last: "Cuối", next: "Tiếp", previous: "Trước" },
                emptyTable: "Không có dữ liệu trong bảng"
            },
            columnDefs: [
                { targets: [10], orderable: false } // Image column không sort được
            ]
        });
    });

    function showImageModal(imageSrc) {
        $('#modalImage').attr('src', imageSrc);
        $('#imageModal').modal('show');
    }
</script>
</body>
</html>
