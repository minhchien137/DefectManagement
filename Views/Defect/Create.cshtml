@model DefectManagement.Models.SVN_quality_reason

@{
    ViewData["Title"] = "Nhập Defect";
}

<link rel="stylesheet" href="~/css/create-form.css" asp-append-version="true" />

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<div class="defect-form-container">
    <div class="form-header">
        <h1 class="form-title">Nhập dữ liệu lỗi</h1>
    </div>

    <form asp-action="Create" id="defectForm">
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">SVN Code</label>
                <input id="Employer_code" name="Employer_code" class="form-control" placeholder="Nhập mã SVN..." />
                <div id="nameEmployerDisplay"
                    style="margin-top: 5px; font-weight: 700; color: #dc2626; font-size: 0.8rem;">
                </div>
                <div style="margin-top: 5px;">
                    <button type="button"
                        style="padding:4px 12px; border:none; font-size:10px; font-weight:700; color:white; border-radius:6px; background-color:#dc2626; cursor:pointer; text-transform:uppercase; letter-spacing:.4px;"
                        onclick="deleteSVNField('Employer_code', this)">Xóa</button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Work Order</label>
                <input id="WorkOrder" name="WorkOrder" class="form-control" placeholder="Nhập số Work Order..." />
                <div id="productionCodeDisplay"
                    style="margin-top: 5px; font-weight: 700; color: #dc2626; font-size: 0.8rem;">
                </div>
                <div style="margin-top: 5px;">
                    <button type="button"
                        style="padding:4px 12px; border:none; font-size:10px; font-weight:700; color:white; border-radius:6px; background-color:#dc2626; cursor:pointer; text-transform:uppercase; letter-spacing:.4px;"
                        onclick="deleteWorkOrderField('WorkOrder', this)">Xóa</button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Operation</label>
                <select id="operation" name="Operation" class="form-control" asp-items="ViewBag.Operations">
                    <option value="">-- Chọn Operation --</option>
                </select>
                <div style="margin-top: 5px;">
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Mã defect</label>
                <select id="code" name="Defect_Code" class="form-control">
                    <option value="">-- Chọn Code --</option>
                </select>
            </div>

            <div class="form-group" style="display: none;">
                <label class="form-label">Tên Defect</label>
                <input id="name" class="form-control" readonly placeholder="" />
            </div>

            <div class="form-group">
                <label class="form-label">Số lượng NG</label>
                <input id="Qty_NG" name="Qty_NG" type="number" class="form-control" placeholder="Nhập số lượng NG..."
                    min="0" />
            </div>


            <!-- Thêm trường upload ảnh -->
            <div class="form-group full-width">
                <label class="form-label">Ảnh lỗi (tùy chọn)</label>
                <div class="image-upload-container">
                    <div class="image-upload-area" id="imageUploadArea"
                        onclick="document.getElementById('imageInput').click()">
                        <div class="upload-text">Nhấp để chọn ảnh</div>
                        <div class="upload-hint">Hỗ trợ: JPG, PNG, GIF, BMP (tối đa 5MB)</div>
                    </div>
                    <input type="file" id="imageInput" name="imageFile" accept="image/*" />
                    <div id="imagePreview" style="display: none;">
                        <img id="previewImg" class="image-preview" />
                        <div class="file-info" id="fileInfo" style="display: none;"></div>
                        <div class="image-actions">
                            <button type="button" class="btn-remove" onclick="removeImage()">Xóa ảnh</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group full-width">
            <label class="form-label">Ghi chú (tùy chọn)</label>
            <textarea id="Note" name="Note" class="form-control" placeholder="Nhập ghi chú (tùy chọn)..."
                rows="4"></textarea>
        </div>



        <div class="btn-container">
            <button type="button" id="btnSaveToDB" class="btn btn-primary">
                Lưu Thông Tin
            </button>
        </div>


    </form>
</div>

<a asp-controller="InputDefectCode" asp-action="Create" class="input-defect-code-link">Thêm mã lỗi &rsaquo;</a>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>

        let currentProductCode = ""; // lưu productCode từ Odoo API
        let currentNameEmployer = ""; // lưu nameEmployer từ Odoo API
        let selectedFile = null; // lưu file đã chọn

        // Toast Notification Function
        function showToast(message, type = 'success', duration = 2000) {
            const toastContainer = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;

            // Icon based on type
            let icon = '';
            switch (type) {
                case 'success':
                    icon = '✓';
                    break;
                case 'error':
                    icon = '✕';
                    break;
                default:
                    icon = 'ℹ';
            }

            toast.innerHTML = `
                                                                                                                                                                                                                                                                                                                                                                                                <span class="toast-icon">${icon}</span>
                                                                                                                                                                                                                                                                                                                                                                                                ${message}
                                                                                                                                                                                                                                                                                                                                                                                                <button class="toast-close" onclick="closeToast(this)">&times;</button>
                                                                                                                                                                                                                                                                                                                                                                                                <div class="toast-progress"></div>
                                                                                                                                                                                                                                                                                                                                                                                            `;

            toastContainer.appendChild(toast);

            // Show toast
            setTimeout(() => {
                toast.style.display = 'block';
            }, 10);

            // Auto hide after duration
            setTimeout(() => {
                hideToast(toast);
            }, duration);

            return toast;
        }

        function hideToast(toast) {
            toast.classList.add('hide');
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 200);
        }

        function closeToast(button) {
            const toast = button.closest('.toast');
            hideToast(toast);
        }


        // === function image ====
        function handleImageSelect(file) {
            if (!file) return;

            // Kiểm tra định dạng file
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/bmp'];
            if (!allowedTypes.includes(file.type)) {
                showToast('Chỉ cho phép upload ảnh với định dạng: JPG, PNG, GIF, BMP', 'error', 3000);
                return;
            }

            // Kiểm tra kích thước file (5MB)
            if (file.size > 5 * 1024 * 1024) {
                showToast('Kích thước ảnh không được vượt quá 5MB', 'error', 3000);
                return;
            }

            selectedFile = file;

            // Hiển thị preview
            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('fileInfo').textContent = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                document.getElementById('imagePreview').style.display = 'block';
                document.getElementById('imageUploadArea').style.display = 'none';
            };
            reader.readAsDataURL(file);
        }

        function removeImage() {
            selectedFile = null;
            document.getElementById('imageInput').value = '';
            document.getElementById('imagePreview').style.display = 'none';
            document.getElementById('imageUploadArea').style.display = 'block';
        }

        // Drag and drop functionality
        const imageUploadArea = document.getElementById('imageUploadArea');

        imageUploadArea.addEventListener('dragover', function (e) {
            e.preventDefault();
            this.classList.add('dragover');
        });

        imageUploadArea.addEventListener('dragleave', function (e) {
            e.preventDefault();
            this.classList.remove('dragover');
        });

        imageUploadArea.addEventListener('drop', function (e) {
            e.preventDefault();
            this.classList.remove('dragover');

            const files = e.dataTransfer.files;
            if (files.length > 0) {
                handleImageSelect(files[0]);
            }
        });

        // File input change event
        document.getElementById('imageInput').addEventListener('change', function (e) {
            if (e.target.files.length > 0) {
                handleImageSelect(e.target.files[0]);
            }
        });



        //============ ODOO Function ========

        // Tự động thêm tiền tố "NM/MO/" nếu người dùng chỉ gõ/paste phần số
        function normalizeWorkOrder(value) {
            if (!value) return value;
            let v = value.trim();
            if (/^NM\/MO\//i.test(v)) {
                return v.toUpperCase();
            }
            return "NM/MO/" + v;
        }

        $(document).ready(function () {

            // Gọi Odoo API khi blur khỏi Work Order
            $('#WorkOrder').on('blur', function () {
                const workOrder = normalizeWorkOrder($(this).val());
                $(this).val(workOrder);
                const productionCodeDisplay = $("#productionCodeDisplay");



                if (workOrder && workOrder.length < 11) {
                    currentProductCode = "";
                    productionCodeDisplay.text("");
                    showToast("Work Order chưa đủ số ký tự (dạng NM/MO/xxxxx)!", 'error', 2000);
                    return;
                }

                if (workOrder) {
                    $.ajax({
                        url: '/api/Odoo/search',
                        type: 'GET',
                        data: { productionCode: workOrder },
                        success: function (res) {
                            if (res && res.productCode) {
                                currentProductCode = res.productCode;
                                productionCodeDisplay.text("Production Code: " + currentProductCode);
                                console.log("✅ Lấy productCode:", currentProductCode);
                            } else {
                                currentProductCode = "";
                                productionCodeDisplay.text(""); // Xóa kết quả cũ
                                showToast("Nhập sai Work Order rồi!", 'error', 2000);
                            }
                        },
                        error: function (err) {
                            currentProductCode = "";
                            console.error("❌ API Odoo lỗi:", err);
                            productionCodeDisplay.text(""); // Xóa kết quả cũ
                            showToast("Nhập sai Work Order rồi!", 'error', 2000);
                        }
                    });
                }
            });

            // Gọi API khi blur khỏi SVN Code

            $('#Employer_code').on('blur', function () {
                const nameEmployer = $(this).val();
                const nameEmployerDisplay = $("#nameEmployerDisplay");



                if (nameEmployer && nameEmployer.length < 7) {
                    currentNameEmployer = "";
                    nameEmployerDisplay.text("");
                    showToast("Bạn phải nhập SVN Code ít nhất 7 ký tự!", 'error', 2000);
                    return;
                }

                if (nameEmployer) {
                    $.ajax({
                        url: '/api/Odoo/SearchName',
                        type: 'GET',
                        data: { nameEmployer: nameEmployer },
                        success: function (res) {
                            if (res && res.nameEmployer) {
                                currentNameEmployer = res.nameEmployer;
                                nameEmployerDisplay.text("Tên nhân viên : " + currentNameEmployer);
                                console.log("✅ Lấy tên nhân viên :", currentNameEmployer);
                            } else {
                                currentNameEmployer = "";
                                nameEmployerDisplay.text(""); // Xóa kết quả cũ
                                showToast("Nhập sai mã SVN Code rồi!", 'error', 2000);
                            }
                        },
                        error: function (err) {
                            currentNameEmployer = "";
                            console.error("❌ API Odoo lỗi:", err);
                            nameEmployerDisplay.text(""); // Xóa kết quả cũ
                            showToast("Nhập sai mã SVN Code rồi!", 'error', 2000);
                        }
                    });
                }
            });

            // Initialize Select2 for dropdowns
            $('#operation').select2({
                placeholder: "Tìm kiếm Operation...",
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function () {
                        return "Không tìm thấy kết quả";
                    },
                    searching: function () {
                        return "Đang tìm kiếm...";
                    },
                    inputTooShort: function () {
                        return "Vui lòng nhập ít nhất 1 ký tự";
                    }
                }
            });

            $('#code').select2({
                placeholder: "Tìm kiếm Mã lỗi...",
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function () {
                        return "Không tìm thấy kết quả";
                    },
                    searching: function () {
                        return "Đang tìm kiếm...";
                    },
                    inputTooShort: function () {
                        return "Vui lòng nhập ít nhất 1 ký tự";
                    }
                }
            });

            // Form validation with Select2 support
            function validateForm() {
                let isValid = true;
                const requiredFields = ['input[name="Employer_code"]', 'input[name="WorkOrder"]', 'select[name="Operation"]', 'select[name="Defect_Code"]', 'input[name="Qty_NG"]'];

                requiredFields.forEach(function (selector) {
                    const field = $(selector);
                    const select2Container = field.next('.select2-container');

                    if (!field.val()) {
                        field.addClass('invalid').removeClass('valid');
                        if (select2Container.length) {
                            select2Container.find('.select2-selection').addClass('invalid').removeClass('valid');
                        }
                        isValid = false;
                    } else {
                        field.addClass('valid').removeClass('invalid');
                        if (select2Container.length) {
                            select2Container.find('.select2-selection').addClass('valid').removeClass('invalid');
                        }
                    }
                });
                // Thêm kiểm tra độ dài cho Work Order
                const workOrderField = $('input[name="WorkOrder"]');
                if (workOrderField.val() && workOrderField.val().length !== 11) {
                    workOrderField.addClass('invalid').removeClass('valid');
                    isValid = false;
                } else if (workOrderField.val()) {
                    workOrderField.addClass('valid').removeClass('invalid');
                }

                return isValid;
            }

            // Real-time validation with Select2 support
            $('input, select').on('blur change', function () {
                const $this = $(this);
                const select2Container = $this.next('.select2-container');

                if ($this.val()) {
                    $this.addClass('valid').removeClass('invalid');
                    if (select2Container.length) {
                        select2Container.find('.select2-selection').addClass('valid').removeClass('invalid');
                    }
                } else {
                    $this.addClass('invalid').removeClass('valid');
                    if (select2Container.length) {
                        select2Container.find('.select2-selection').addClass('invalid').removeClass('valid');
                    }
                }
            });

            // Select2 change events
            $('#operation').on('select2:select select2:unselect', function () {
                $(this).trigger('change');
            });

            $('#code').on('select2:select select2:unselect', function () {
                $(this).trigger('change');
            });

            // Operation change handler with Select2
            $("#operation").change(function () {
                const operation = $(this).val();
                const $codeSelect = $("#code");
                const $nameInput = $("#name");

                // Clear and disable code select while loading
                $codeSelect.empty().append('<option value="">-- Đang tải... --</option>');
                $codeSelect.prop('disabled', true).trigger('change.select2');
                $nameInput.val('');

                if (operation) {
                    $.getJSON('/Defect/GetCodesByOperation', { operation: operation })
                        .done(function (data) {
                            $codeSelect.empty().append('<option value="">-- Chọn Code --</option>');
                            $.each(data, function (i, item) {
                                $codeSelect.append($('<option>', {
                                    value: item.code,
                                    text: item.code + ' - ' + item.name
                                }).data("name", item.name));
                            });
                            $codeSelect.prop('disabled', false).trigger('change.select2');
                        })
                        .fail(function () {
                            $codeSelect.empty().append('<option value="">-- Lỗi tải dữ liệu --</option>');
                            $codeSelect.prop('disabled', false).trigger('change.select2');
                        });
                } else {
                    $codeSelect.empty().append('<option value="">-- Chọn Code --</option>');
                    $codeSelect.prop('disabled', false).trigger('change.select2');
                    @* showToast("Lỗi khi tải dữ liệu defect codes!", 'error', 2000); *@
                                                                                                                                                                                                                                                                                                                                                                                                }
            });

            // Code change handler
            $("#code").change(function () {
                const selectedName = $(this).find(':selected').data("name") || '';
                $("#name").val(selectedName);
            });

            // Auto-focus first input
            $('input[name="Employer_code"]').focus();
        });


        document.getElementById("btnSaveToDB").addEventListener("click", async function (e) {
            e.preventDefault();

            // Validate form trước khi gửi
            const employerCode = document.getElementById("Employer_code").value;
            const workOrderInput = document.getElementById("WorkOrder");
            const workOrder = normalizeWorkOrder(workOrderInput.value);
            workOrderInput.value = workOrder;
            const operation = document.getElementById("operation").value;
            const defectCode = document.getElementById("code").value;
            const defectName = document.getElementById("name").value;
            const qtyNG = document.getElementById("Qty_NG").value;

            if (!employerCode || !workOrder || !operation || !defectCode || !qtyNG || qtyNG <= 0) {
                showToast("Vui lòng điền đầy đủ thông tin bắt buộc!", 'error', 2000);
                return;
            }

            if (!currentProductCode) {
                showToast("Hệ thống chưa xác nhận Work Order. Vui lòng click ra ngoài ô Work Order và thử lại!", 'error', 3000);
                return;
            }

            if (employerCode) localStorage.setItem('Employer_code', employerCode);
            if (workOrder)    localStorage.setItem('WorkOrder', workOrder);
            if (operation)    localStorage.setItem('Operation', operation);

            const btn = this;
            btn.disabled = true;
            btn.textContent = "Đang lưu...";

            const formData = new FormData();
            formData.append('Employer_code', employerCode);
            formData.append('Work_order', workOrder);
            formData.append('Item_code', currentProductCode);
            formData.append('Operation', operation);
            formData.append('Defect_Code', defectCode);
            formData.append('Defect_Name', defectName);
            formData.append('Employer_name', currentNameEmployer);
            formData.append('Qty_NG', qtyNG);
            const noteValue = document.getElementById("Note").value || '';
            formData.append('Note', noteValue);

            const imageInput = document.getElementById('imageInput');
            if (imageInput.files.length > 0) {
                formData.append('imageFile', imageInput.files[0]);
            }

            fetch('/Defect/Create', {
                method: 'POST',
                body: formData
            })
                .then(res => {
                    if (!res.ok) throw new Error("Lưu thông tin không thành công!");
                    return res.json();
                })
                .then(response => {
                    console.log("Response:", response);
                    if (response.success) {
                        showToast(response.message || "Lưu thông tin thành công!", 'success', 2500);
                        document.getElementById("defectForm").reset();
                        $('#operation').val(null).trigger('change');
                        $('#code').val(null).trigger('change');
                        document.getElementById("name").value = '';
                        setTimeout(() => { autofillFields(); }, 100);
                    } else {
                        showToast(response.message || "Lưu thông tin không thành công!", 'error', 2500);
                    }
                })
                .catch(err => {
                    console.error("Error:", err);
                    showToast("Lưu thông tin không thành công!", 'error', 2500);
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.textContent = "Lưu Thông Tin";
                });
        });



        // xóa nhỏ SVN Code
        function deleteSVNField(fieldId, button) {
            localStorage.removeItem(fieldId);
            document.getElementById("nameEmployerDisplay").innerHTML = "";
            const field = document.getElementById(fieldId);
            if (field) {
                field.value = '';
                if ($(field).hasClass('select2-hidden-accessible')) {
                    $(field).val(null).trigger('change');
                }
            }
        }


        // xóa nhỏ Work Order
        function deleteWorkOrderField(fieldId, button) {
            localStorage.removeItem(fieldId);
            document.getElementById("productionCodeDisplay").innerHTML = "";
            const field = document.getElementById(fieldId);
            if (field) {
                field.value = '';
                if ($(field).hasClass('select2-hidden-accessible')) {
                    $(field).val(null).trigger('change');
                }
            }
        }

        function autofillFields() {
            const employerCode = localStorage.getItem('Employer_code');
            const workOrder = localStorage.getItem('WorkOrder');
            const operation = localStorage.getItem('Operation');

            if (employerCode) {
                $('#Employer_code').val(employerCode);
                // Auto-lookup tên nhân viên
                $.ajax({
                    url: '/api/Odoo/SearchName',
                    type: 'GET',
                    data: { nameEmployer: employerCode },
                    success: function (res) {
                        if (res && res.nameEmployer) {
                            currentNameEmployer = res.nameEmployer;
                            $("#nameEmployerDisplay").text("Tên nhân viên : " + currentNameEmployer);
                        }
                    }
                });
            }
            if (workOrder) {
                $('#WorkOrder').val(workOrder);
                // Auto-lookup productCode để tránh lỗi Item_code rỗng khi submit
                $.ajax({
                    url: '/api/Odoo/search',
                    type: 'GET',
                    data: { productionCode: workOrder },
                    success: function (res) {
                        if (res && res.productCode) {
                            currentProductCode = res.productCode;
                            $("#productionCodeDisplay").text("Production Code: " + currentProductCode);
                        }
                    }
                });
            }
            if (operation) {
                if ($('#operation option[value="' + operation + '"]').length > 0) {
                    $('#operation').val(operation).trigger('change');
                }
            }
        }
        autofillFields();
    </script>
}