<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<script>
/* ============================================================
   TOM SELECT – searchable dropdowns
   Dùng onDropdownOpen để reposition dropdown về fixed position
   → thoát khỏi mọi overflow, không bị che, không xuống cuối trang
============================================================ */
function makeTomSelect(selector, extraOpts) {
    const el = document.querySelector(selector);
    if (!el) return;
    const ts = new TomSelect(selector, Object.assign({
        allowEmptyOption : true,
        placeholder      : '-- Tất cả --',
        maxOptions       : 1000,
        dropdownParent   : 'body'
    }, extraOpts || {}));
    return ts;
}

makeTomSelect('#selWorkOrder');
makeTomSelect('#selOperation');
makeTomSelect('#selItemCode');

// Defect Code: custom render hiển thị badge code + tên
makeTomSelect('#selDefectCode', {
    render: {
        option: function(data, escape) {
            const raw  = data.text || '';
            const dash = raw.indexOf(' - ');
            if (dash >= 0) {
                const code = escape(raw.slice(0, dash).trim());
                const name = escape(raw.slice(dash + 3).trim());
                return '<div style="display:flex;align-items:center;gap:8px;padding:5px 10px">'
                     + '<span style="background:#fef3c7;color:#92400e;border:1px solid #f59e0b;'
                     +       'border-radius:5px;padding:1px 7px;font-size:11px;font-weight:700;'
                     +       'white-space:nowrap;min-width:32px;text-align:center">' + code + '</span>'
                     + '<span style="color:#374151;font-size:12.5px">' + name + '</span>'
                     + '</div>';
            }
            return '<div style="padding:5px 10px">' + escape(raw) + '</div>';
        },
        item: function(data, escape) {
            return '<div>' + escape(data.text || '') + '</div>';
        }
    }
});

/* ============================================================
   TABLE SORT
============================================================ */
const sortDir = {};
function sortTable(col, thEl) {
    const tbody = document.getElementById('defectTable')?.tBodies[0];
    if (!tbody) return;
    const rows = Array.from(tbody.rows);
    sortDir[col] = !sortDir[col];
    document.querySelectorAll('#defectTable .sort-icon').forEach(el => el.textContent = '⇅');
    if (thEl) thEl.querySelector('.sort-icon').textContent = sortDir[col] ? '▲' : '▼';
    rows.sort((a, b) => {
        const va = a.cells[col]?.innerText.trim() || '';
        const vb = b.cells[col]?.innerText.trim() || '';
        const na = parseFloat(va), nb = parseFloat(vb);
        if (!isNaN(na) && !isNaN(nb)) return sortDir[col] ? na - nb : nb - na;
        return sortDir[col] ? va.localeCompare(vb, 'vi') : vb.localeCompare(va, 'vi');
    });
    rows.forEach(r => tbody.appendChild(r));
}

/* ============================================================
   DETAIL POPUP
============================================================ */
function showDetail(id) {
    const modalEl = document.getElementById('detailModal');
    const modal   = bootstrap.Modal.getOrCreateInstance(modalEl);
    document.getElementById('detailModalBody').innerHTML =
        '<div class="text-center py-5"><div class="spinner-border" style="color:#2a5298"></div></div>';
    modal.show();

    fetch(`/Defect/GetDefectDetail?id=${id}`)
        .then(r => r.json())
        .then(res => {
            if (!res.success) {
                document.getElementById('detailModalBody').innerHTML =
                    `<div class="alert alert-danger">${res.message}</div>`;
                return;
            }
            const d = res.data;
            const imgHtml = d.image_error
                ? `<img src="${d.image_error}" class="img-fluid rounded mb-2 w-100"
                          style="max-height:280px;object-fit:contain;cursor:pointer"
                          onclick="showImage('${d.image_error}')" />`
                : `<div class="text-center text-muted py-4 border rounded mb-2 bg-light">
                       <i class="fas fa-image fa-3x mb-2 d-block"></i>Không có ảnh
                   </div>`;

            const buildTbl = (cols, bodyHtml) => !bodyHtml
                ? '<p class="text-muted small">Không có bản ghi</p>'
                : `<div class="table-responsive" style="max-height:190px;overflow-y:auto">
                   <table class="table table-sm table-bordered history-tbl mb-0">
                       <thead><tr>${cols.map(c => `<th>${c}</th>`).join('')}</tr></thead>
                       <tbody>${bodyHtml}</tbody>
                   </table></div>`;

            const woRows = res.sameWO.map(r =>
                `<tr>
                    <td><span class="badge-dc">${r.defect_Code||''}</span></td>
                    <td>${r.defect_Name||''}</td>
                    <td class="text-center fw-bold" style="color:#e53e3e">${r.qty_NG||0}</td>
                    <td><span class="badge-op">${r.operation||''}</span></td>
                    <td>${r.employer_name||''}</td>
                    <td class="text-nowrap small">${r.timeLine||''}</td>
                </tr>`).join('');

            const defRows = res.sameDefectInWO.map(r =>
                `<tr>
                    <td class="text-center fw-bold" style="color:#e53e3e">${r.qty_NG||0}</td>
                    <td>${r.employer_name||''}</td>
                    <td>${r.note||''}</td>
                    <td class="text-nowrap small">${r.timeLine||''}</td>
                </tr>`).join('');

            document.getElementById('detailModalBody').innerHTML = `
            <div class="row g-3">
                <div class="col-12 col-md-5">
                    ${imgHtml}
                    <div class="detail-section-title">
                        <i class="fas fa-info-circle me-1"></i>Thông tin chính
                    </div>
                    <table class="table table-sm table-borderless mb-0" style="font-size:12.5px">
                        <tr><td class="text-muted fw-bold" style="width:42%;white-space:nowrap">Work Order:</td>
                            <td><strong>${d.work_order||''}</strong></td></tr>
                        <tr><td class="text-muted fw-bold">Item Code:</td>
                            <td>${d.item_code||''}</td></tr>
                        <tr><td class="text-muted fw-bold">Defect Code:</td>
                            <td><span class="badge-dc">${d.defect_Code||''}</span></td></tr>
                        <tr><td class="text-muted fw-bold">Defect Name:</td>
                            <td><strong style="color:#e53e3e">${d.defect_Name||''}</strong></td></tr>
                        <tr><td class="text-muted fw-bold">Qty NG:</td>
                            <td><strong style="color:#e53e3e;font-size:1.2rem">${d.qty_NG||0}</strong></td></tr>
                        <tr><td class="text-muted fw-bold">Operation:</td>
                            <td><span class="badge-op">${d.operation||''}</span></td></tr>
                        <tr><td class="text-muted fw-bold">Employer:</td>
                            <td>${d.employer_code||''} – ${d.employer_name||''}</td></tr>
                        <tr><td class="text-muted fw-bold">Note:</td>
                            <td>${d.note||'—'}</td></tr>
                        <tr><td class="text-muted fw-bold">INS Date:</td>
                            <td>${d.inSDatetime||''}</td></tr>
                        <tr><td class="text-muted fw-bold">Time Line:</td>
                            <td><strong>${d.timeLine||''}</strong></td></tr>
                    </table>
                </div>
                <div class="col-12 col-md-7">
                    <div class="detail-section-title">
                        <i class="fas fa-history me-1"></i>Lịch sử cùng Work Order
                        <span class="badge bg-secondary ms-1">${res.sameWO.length}</span>
                    </div>
                    ${buildTbl(['Defect Code','Defect Name','Qty NG','Operation','Employer','Time'], woRows)}
                    <div class="detail-section-title mt-3">
                        <i class="fas fa-bug me-1"></i>Cùng Defect Code
                        <em style="color:#e53e3e">[${d.defect_Code}]</em> trong WO này
                        <span class="badge bg-secondary ms-1">${res.sameDefectInWO.length}</span>
                    </div>
                    ${buildTbl(['Qty NG','Employer','Note','Time'], defRows)}
                </div>
            </div>`;
        })
        .catch(err => {
            document.getElementById('detailModalBody').innerHTML =
                `<div class="alert alert-danger">Lỗi: ${err.message}</div>`;
        });
}

/* ============================================================
   IMAGE FULLSIZE
============================================================ */
function showImage(src) {
    document.getElementById('fullImage').src = src;
    bootstrap.Modal.getOrCreateInstance(document.getElementById('imageModal')).show();
}
</script>

@if (totalRecords > 0)
{
    <script>
    /* ============================================================
       DATA FROM SERVER
    ============================================================ */
    const opLabels  = @Html.Raw(ViewBag.ChartOperationLabels ?? "[]");
    const opQtyNG   = @Html.Raw(ViewBag.ChartOperationQtyNG  ?? "[]");
    const opCounts  = @Html.Raw(ViewBag.ChartOperationCounts ?? "[]");

    const paretoLabels = @Html.Raw(ViewBag.ParetoLabels     ?? "[]");
    const paretoQtyNG  = @Html.Raw(ViewBag.ParetoQtyNG      ?? "[]");
    const paretoCum    = @Html.Raw(ViewBag.ParetoCumulative ?? "[]");

    // Pie chart – top 10 operations (thay vì defect name)
    const pieLabels = @Html.Raw(ViewBag.PieLabels ?? "[]");
    const pieVals   = @Html.Raw(ViewBag.PieData   ?? "[]");

    const trendDates  = @Html.Raw(ViewBag.DailyDates     ?? "[]");
    const trendQtyNG  = @Html.Raw(ViewBag.DailyQtyNG     ?? "[]");
    const trendCounts = @Html.Raw(ViewBag.DailyCounts    ?? "[]");
    const movingAvg   = @Html.Raw(ViewBag.DailyMovingAvg ?? "[]");

    /* ============================================================
       HELPERS
    ============================================================ */
    const PALETTE = [
        '#2563eb','#e53e3e','#d69e2e','#059669','#7c3aed',
        '#db2777','#ea580c','#0891b2','#65a30d','#4338ca',
        '#be185d','#0369a1','#b45309','#15803d','#6d28d9'
    ];
    function rgba(hex, a) {
        const r = parseInt(hex.slice(1,3),16),
              g = parseInt(hex.slice(3,5),16),
              b = parseInt(hex.slice(5,7),16);
        return `rgba(${r},${g},${b},${a})`;
    }

    /* ============================================================
       HELPER – gộp operation label
       Walter-WSS03-00290  → Walter
       Injection_POP       → POP (chỉ lấy phần sau _ cuối nếu có _)
       POP                 → POP
    ============================================================ */
    function groupOpLabel(label) {
        if (!label) return 'N/A';
        // Nếu có dấu - thì lấy phần trước dấu - đầu tiên
        if (label.includes('-')) return label.split('-')[0].trim();
        // Nếu có dấu _ thì lấy phần sau dấu _ cuối cùng
        if (label.includes('_')) {
            const parts = label.split('_');
            return parts[parts.length - 1].trim();
        }
        return label.trim();
    }

    /* -- Gộp opLabels/opQtyNG/opCounts theo nhóm -- */
    function mergeByGroup(labels, qtyArr, cntArr) {
        const map = {};
        labels.forEach((lb, i) => {
            const grp = groupOpLabel(lb);
            if (!map[grp]) map[grp] = { qty: 0, cnt: 0 };
            map[grp].qty += qtyArr[i] || 0;
            map[grp].cnt += cntArr[i] || 0;
        });
        const keys   = Object.keys(map).sort((a,b) => map[b].qty - map[a].qty);
        return {
            labels: keys,
            qty:    keys.map(k => map[k].qty),
            cnt:    keys.map(k => map[k].cnt)
        };
    }

    /* -- Gộp pareto theo Defect Name (bỏ code prefix) -- */
    function mergePareto(labels, qtyArr) {
        const map = {};
        labels.forEach((lb, i) => {
            // label dạng "R14 - Lost roughness" → lấy phần sau " - "
            let name = lb;
            const sep = lb.indexOf(' - ');
            if (sep >= 0) name = lb.slice(sep + 3).trim();
            if (!map[name]) map[name] = 0;
            map[name] += qtyArr[i] || 0;
        });
        const keys = Object.keys(map).sort((a,b) => map[b] - map[a]);
        const totalNG = keys.reduce((s,k) => s + map[k], 0);
        let cum = 0;
        const cumArr = keys.map(k => {
            cum += totalNG > 0 ? map[k] / totalNG * 100 : 0;
            return Math.round(cum * 10) / 10;
        });
        return { labels: keys, qty: keys.map(k => map[k]), cum: cumArr };
    }

    const opMerged     = mergeByGroup(opLabels, opQtyNG, opCounts);
    const paretoMerged = mergePareto(paretoLabels, paretoQtyNG);
    const totalQtyNG_all = opMerged.qty.reduce((s,v) => s+v, 0);

    /* ============================================================
       CHART 1 – DEFECT BY OPERATION (gộp)
    ============================================================ */
    new Chart(document.getElementById('operationChart'), {
        type: 'bar',
        data: {
            labels: opMerged.labels,
            datasets: [{
                label: 'Tổng Qty NG',
                data: opMerged.qty,
                backgroundColor: opMerged.labels.map((_,i) => rgba(PALETTE[i % PALETTE.length], 0.85)),
                borderColor:     opMerged.labels.map((_,i) => PALETTE[i % PALETTE.length]),
                borderWidth: 1,
                borderRadius: 5
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => {
                            const pct = totalQtyNG_all > 0 ? ((ctx.parsed.y / totalQtyNG_all)*100).toFixed(1) : 0;
                            const cnt = opMerged.cnt[ctx.dataIndex] || 0;
                            return [`  Qty NG: ${ctx.parsed.y} (${pct}%)`, `  Số lần: ${cnt}`];
                        }
                    }
                }
            },
            scales: {
                y: { beginAtZero: true,
                     title: { display: true, text: 'Qty NG', font: { size: 11 } },
                     ticks: { font: { size: 10 } } },
                x: { ticks: { font: { size: 10 }, maxRotation: 30 } }
            },
            animation: { duration: 1000, easing: 'easeOutQuart' }
        }
    });

    /* ============================================================
       CHART 2 – PARETO DEFECT NAME (gộp theo tên)
    ============================================================ */
    new Chart(document.getElementById('paretoChart'), {
        type: 'bar',
        data: {
            labels: paretoMerged.labels.slice(0, 15),
            datasets: [
                {
                    type: 'bar',
                    label: 'Qty NG',
                    data: paretoMerged.qty.slice(0, 15),
                    backgroundColor: rgba('#e53e3e', 0.8),
                    borderRadius: 4,
                    yAxisID: 'y'
                },
                {
                    type: 'line',
                    label: '% Tích lũy',
                    data: paretoMerged.cum.slice(0, 15),
                    borderColor: '#d69e2e',
                    backgroundColor: rgba('#d69e2e', 0.1),
                    borderWidth: 2.5,
                    pointRadius: 4,
                    tension: 0.3,
                    fill: false,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: { display: true, position: 'top', labels: { font: { size: 11 }, usePointStyle: true } },
                tooltip: { mode: 'index', intersect: false }
            },
            scales: {
                x: { ticks: { font: { size: 9 }, maxRotation: 45 } },
                y: { beginAtZero: true,
                     title: { display: true, text: 'Qty NG', font: { size: 10 } },
                     ticks: { font: { size: 10 } } },
                y1: {
                    type: 'linear', position: 'right', min: 0, max: 100,
                    title: { display: true, text: '% Tích lũy', font: { size: 10 } },
                    ticks: { font: { size: 10 }, callback: v => v + '%' },
                    grid: { drawOnChartArea: false }
                }
            },
            animation: { duration: 1200, easing: 'easeOutQuart' }
        }
    });

    /* ============================================================
       CHART 3 – PIE: TOP 10 OPERATION NHIỀU LỖI (không gộp, từng operation riêng)
    ============================================================ */
    // Sắp xếp theo qty giảm dần, lấy top 10
    const pieRaw = opLabels.map((lb, i) => ({ label: lb, qty: opQtyNG[i] || 0 }))
                           .sort((a, b) => b.qty - a.qty)
                           .slice(0, 10);
    const pieOpLabels = pieRaw.map(x => x.label);
    const pieOpVals   = pieRaw.map(x => x.qty);
    const pieOpTotal  = pieOpVals.reduce((s,v) => s+v, 0);

    new Chart(document.getElementById('pieChart'), {
        type: 'doughnut',
        data: {
            labels: pieOpLabels,
            datasets: [{
                data: pieOpVals,
                backgroundColor: PALETTE.slice(0, pieOpVals.length).map(c => rgba(c, 0.88)),
                borderColor: '#fff',
                borderWidth: 2
            }]
        },
        plugins: [ChartDataLabels],
        options: {
            responsive: true, maintainAspectRatio: false, cutout: '52%',
            plugins: {
                legend: { display: true, position: 'right',
                          labels: { font: { size: 10 }, padding: 8, boxWidth: 12 } },
                tooltip: {
                    callbacks: {
                        label: ctx => {
                            const pct = pieOpTotal > 0
                                ? ((ctx.parsed / pieOpTotal)*100).toFixed(1) : 0;
                            return ` ${ctx.label}: ${ctx.parsed} (${pct}%)`;
                        }
                    }
                },
                datalabels: {
                    formatter: v => {
                        const pct = pieOpTotal > 0 ? (v/pieOpTotal*100).toFixed(1) : 0;
                        return pct >= 5 ? pct + '%' : '';
                    },
                    color: '#fff', font: { weight: 'bold', size: 10 },
                    align: 'center', anchor: 'center'
                }
            },
            animation: { duration: 1300 }
        }
    });

    /* ============================================================
       CHART 4 – TREND + MOVING AVG
    ============================================================ */
    const trendCtxEl = document.getElementById('trendChart');
    const tc = trendCtxEl.getContext('2d');
    const gradRed  = tc.createLinearGradient(0, 0, 0, 380);
    gradRed.addColorStop(0, rgba('#e53e3e', .35));
    gradRed.addColorStop(1, rgba('#e53e3e', .02));
    const gradBlue = tc.createLinearGradient(0, 0, 0, 380);
    gradBlue.addColorStop(0, rgba('#2563eb', .3));
    gradBlue.addColorStop(1, rgba('#2563eb', .02));

    new Chart(trendCtxEl, {
        type: 'line',
        data: {
            labels: trendDates,
            datasets: [
                {
                    label: 'Qty NG theo ngày',
                    data: trendQtyNG,
                    borderColor: '#e53e3e',
                    backgroundColor: gradRed,
                    borderWidth: 2.5,
                    fill: true, tension: 0.4,
                    pointRadius: 4, pointHoverRadius: 8,
                    pointBackgroundColor: '#e53e3e',
                    yAxisID: 'y'
                },
                {
                    label: 'Số lần phát sinh lỗi',
                    data: trendCounts,
                    borderColor: '#2563eb',
                    backgroundColor: gradBlue,
                    borderWidth: 2,
                    borderDash: [5, 4],
                    fill: true, tension: 0.4,
                    pointRadius: 3, pointHoverRadius: 7,
                    pointBackgroundColor: '#2563eb',
                    yAxisID: 'y1'
                },
                {
                    label: 'Moving Avg 7 ngày',
                    data: movingAvg,
                    borderColor: '#d69e2e',
                    backgroundColor: 'transparent',
                    borderWidth: 2.5,
                    borderDash: [8, 4],
                    fill: false, tension: 0.4,
                    pointRadius: 0, pointHoverRadius: 6,
                    yAxisID: 'y'
                }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { display: true, position: 'top',
                          labels: { font: { size: 12 }, usePointStyle: true, padding: 16 } },
                tooltip: {
                    backgroundColor: 'rgba(20,25,40,.88)', padding: 10, cornerRadius: 8,
                    callbacks: { label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y}` }
                }
            },
            scales: {
                x: {
                    title: { display: true, text: 'Ngày', font: { size: 11, weight: 'bold' } },
                    ticks: { font: { size: 10 }, maxRotation: 45 }
                },
                y: {
                    type: 'linear', position: 'left', beginAtZero: true,
                    title: { display: true, text: 'Qty NG', font: { size: 11, weight: 'bold' } },
                    ticks: { font: { size: 10 } }
                },
                y1: {
                    type: 'linear', position: 'right', beginAtZero: true,
                    title: { display: true, text: 'Số lần', font: { size: 11, weight: 'bold' } },
                    ticks: { font: { size: 10 } },
                    grid: { drawOnChartArea: false }
                }
            },
            animation: { duration: 1600, easing: 'easeOutQuart' }
        }
    });
    </script>
}
</body>
</html>
