@model List<DefectManagement.Models.SVN_Defect_Record_History>
@{
    ViewData["Title"] = "Báo Cáo Defect";

    int currentPage   = ViewBag.CurrentPage     ?? 1;
    int pageSize      = ViewBag.PageSize        ?? 10;
    int totalRecords  = ViewBag.TotalRecords    ?? 0;
    int totalPages    = ViewBag.TotalPages      ?? 1;
    bool hasPrevPage  = ViewBag.HasPreviousPage ?? false;
    bool hasNextPage  = ViewBag.HasNextPage     ?? false;

    string fromDate   = ViewBag.FromDate   ?? "";
    string toDate     = ViewBag.ToDate     ?? "";
    string workOrder  = ViewBag.WorkOrder  ?? "";
    string operation  = ViewBag.Operation  ?? "";
    string defectCode = ViewBag.DefectCode ?? "";
    string itemCode   = ViewBag.ItemCode   ?? "";

    var pageSizeOptions = new[] { 5, 10, 25, 50, 100 };

    // Lấy danh sách unique để làm dropdown filter
    var allModels = Model ?? new List<DefectManagement.Models.SVN_Defect_Record_History>();

    // Lấy toàn bộ list để populate dropdown (từ ViewBag nếu có)
    var allWorkOrders  = ViewBag.AllWorkOrders  as List<string>             ?? new List<string>();
    var allOperations  = ViewBag.AllOperations  as List<string>             ?? new List<string>();
    var allDefectCodes = ViewBag.AllDefectCodes as List<string>             ?? new List<string>();
    var allDefectNames = ViewBag.AllDefectNames as Dictionary<string,string> ?? new Dictionary<string,string>();
    var allItemCodes   = ViewBag.AllItemCodes   as List<string>             ?? new List<string>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <!-- Tom Select – searchable dropdown -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <style>
        /* ===== BASE ===== */
        *, *::before, *::after { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f4f8;
            font-size: 14px;
            overflow-x: hidden;
        }

        /* ===== PAGE HEADER – BLUE ===== */
        .page-header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 60%, #3b82f6 100%);
            color: #fff;
            padding: 1.2rem 1.5rem;
            border-radius: 12px;
            margin-bottom: 1.4rem;
            box-shadow: 0 4px 18px rgba(42,82,152,.4);
        }
        .page-header h1 {
            font-size: clamp(1rem, 3.5vw, 1.6rem);
            margin: 0;
            font-weight: 700;
            letter-spacing: .3px;
        }

        /* ===== CARD BOX ===== */
        .card-box {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
            padding: 1rem 1.2rem;
            margin-bottom: 1.25rem;
        }

        /* ===== KPI CARDS ===== */
        .stats-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
            padding: 1rem 1.2rem;
            margin-bottom: 1rem;
            transition: transform .2s, box-shadow .2s;
            border-left: 4px solid transparent;
        }
        .stats-card:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,.13); }
        .stats-card.kpi-blue    { border-left-color: #2a5298; }
        .stats-card.kpi-danger  { border-left-color: #e53e3e; }
        .stats-card.kpi-warning { border-left-color: #d69e2e; }
        .stats-card h5 { font-size: .8rem; color: #718096; margin-bottom: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
        .stats-card h2 { font-size: clamp(1.5rem, 4vw, 2.1rem); margin: 0; font-weight: 700; }

        /* ===== CHART CONTAINERS ===== */
        .chart-box {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
            padding: 1.1rem 1.2rem;
            margin-bottom: 1.25rem;
            height: 370px;
            display: flex;
            flex-direction: column;
        }
        .chart-box canvas { flex: 1; min-height: 0; width: 100% !important; }
        .chart-box h4 { font-size: .88rem; font-weight: 700; margin-bottom: .5rem; flex-shrink: 0; color: #2d3748; }

        .trend-box {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
            padding: 1.1rem 1.2rem;
            margin-bottom: 1.25rem;
            height: 400px;
            display: flex;
            flex-direction: column;
        }
        .trend-box canvas { flex: 1; min-height: 0; width: 100% !important; }
        .trend-box h4 { font-size: .88rem; font-weight: 700; margin-bottom: .5rem; flex-shrink: 0; color: #2d3748; }

        /* ===== TABLE ===== */
        .table-defect thead th {
            background: #2a5298;
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            vertical-align: middle;
            white-space: nowrap;
            border-color: #3b65b8;
        }
        .table-defect td { vertical-align: middle; font-size: 12px; border-color: #e8ecf4; }
        .table-defect tbody tr { cursor: pointer; transition: background .12s; }
        .table-defect tbody tr:hover { background-color: #eef3ff !important; }
        .table-defect tbody tr:nth-child(even) { background-color: #f8faff; }

        /* ===== BADGE OPERATION ===== */
        .badge-op {
            background: #2a5298;
            color: #fff;
            padding: 2px 9px;
            border-radius: 20px;
            font-size: 10px;
            white-space: nowrap;
            font-weight: 600;
        }

        /* ===== BADGE DEFECT CODE ===== */
        .badge-dc {
            background: #fef3c7;
            color: #92400e;
            padding: 2px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            border: 1px solid #f59e0b;
        }

        /* ===== IMAGE THUMB ===== */
        .img-thumb {
            width: 44px; height: 44px;
            object-fit: cover;
            border-radius: 6px;
            cursor: pointer;
            transition: transform .2s;
            border: 2px solid #cbd5e0;
        }
        .img-thumb:hover { transform: scale(1.22); }

        /* ===== EXPORT BTN ===== */
        .btn-export {
            background: linear-gradient(135deg, #059669 0%, #34d399 100%);
            color: #fff !important;
            border: none;
            padding: .45rem 1.3rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 13px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: transform .15s, box-shadow .15s;
            box-shadow: 0 2px 6px rgba(5,150,105,.3);
        }
        .btn-export:hover { transform: translateY(-2px); box-shadow: 0 5px 14px rgba(5,150,105,.4); }

        /* ===== FILTER BUTTONS ===== */
        .btn-filter-apply {
            background: linear-gradient(135deg, #1e3c72 0%, #3b82f6 100%);
            color: #fff;
            border: none;
            padding: .42rem 1.2rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: transform .15s, box-shadow .15s;
        }
        .btn-filter-apply:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(30,60,114,.35); }
        .btn-filter-clear {
            background: #fff;
            color: #4a5568;
            border: 1.5px solid #cbd5e0;
            padding: .42rem 1.2rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: border-color .15s, color .15s;
        }
        .btn-filter-clear:hover { border-color: #e53e3e; color: #e53e3e; }

        /* ===== SORT ===== */
        .sortable { cursor: pointer; user-select: none; }
        .sortable:hover { background-color: #3b65b8 !important; }
        .sort-icon { font-size: 9px; margin-left: 3px; opacity: .8; }

        /* ===== PAGINATION ===== */
        .page-link { font-size: 13px; color: #2a5298; }
        .page-item.active .page-link { background-color: #2a5298; border-color: #2a5298; }

        /* ===== DETAIL MODAL ===== */
        .detail-section-title {
            font-size: 12.5px; font-weight: 700; color: #2a5298;
            border-bottom: 2px solid #2a5298;
            padding-bottom: 4px; margin-bottom: 10px;
        }
        .history-tbl th { font-size: 11px; background-color: #ebf0fb !important; color: #2d3748; }
        .history-tbl td { font-size: 11px; }
        .modal-img-full { width: 100%; max-height: 460px; object-fit: contain; }
        .modal-header-blue { background: linear-gradient(135deg,#1e3c72,#2a5298); color:#fff; }

        /* ===== FILTER CARD – overflow visible để dropdown không bị cắt ===== */
        .filter-card {
            overflow: visible !important;
            position: relative;
            z-index: 200;
        }
        /* Đảm bảo tất cả row/col bên trong cũng không cắt overflow */
        .filter-card .row,
        .filter-card .col-6,
        .filter-card .col-sm-4,
        .filter-card .col-md-3,
        .filter-card .col-lg-2 {
            overflow: visible !important;
        }

        /* ===== TOM-SELECT custom ===== */
        .ts-wrapper { overflow: visible !important; }
        .ts-control {
            border-radius: 6px !important;
            border-color: #cbd5e0 !important;
            font-size: 13px !important;
            min-height: 31px !important;
            padding: 3px 8px !important;
        }
        .ts-dropdown {
            font-size: 13px;
            z-index: 99999 !important;
            box-shadow: 0 8px 24px rgba(0,0,0,.15) !important;
            border: 1px solid #cbd5e0 !important;
            border-radius: 8px !important;
            max-height: 260px;
            overflow-y: auto;
        }
        .ts-dropdown .option { padding: 6px 12px; }
        .ts-dropdown .option:hover, .ts-dropdown .option.active { background: #ebf0fb !important; color: #2a5298 !important; }

        /* ===== ANIMATIONS ===== */
        @@keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .fade-up   { animation: fadeUp .4s ease-out both; }
        .fade-up-2 { animation: fadeUp .4s .08s ease-out both; }
        .fade-up-3 { animation: fadeUp .4s .16s ease-out both; }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 991.98px) {
            .chart-box { height: 310px; }
            .trend-box { height: 330px; }
        }
        @@media (max-width: 767.98px) {
            .chart-box  { height: 280px; }
            .trend-box  { height: 290px; }
            .stats-card h2 { font-size: 1.5rem; }
            .col-sm-hide { display: none !important; }
        }
        @@media (max-width: 575.98px) {
            .chart-box { height: 260px; }
            .trend-box { height: 270px; }
            .filter-btns { flex-direction: column; }
            .filter-btns > * { width: 100%; text-align: center; }
        }
    </style>
</head>
<body>
<div class="container-fluid px-3 px-md-4 mt-3 pb-5">

    <!-- ===== HEADER ===== -->
    <div class="page-header fade-up">
        <h1></i>Báo Cáo Defect</h1>
    </div>

    <!-- ===== ERROR ===== -->
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ===== FILTER ===== -->
    <div class="card-box filter-card fade-up-2">
        <form method="get" asp-action="Report" id="filterForm">
            <div class="row g-2 align-items-end">

                <!-- Từ ngày -->
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <label class="form-label fw-bold small mb-1">
                        <i class="fas fa-calendar-alt" style="color:#2a5298"></i> Từ ngày
                    </label>
                    <input type="date" class="form-control form-control-sm" name="fromDate" value="@fromDate" />
                </div>

                <!-- Đến ngày -->
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <label class="form-label fw-bold small mb-1">
                        <i class="fas fa-calendar-alt" style="color:#2a5298"></i> Đến ngày
                    </label>
                    <input type="date" class="form-control form-control-sm" name="toDate" value="@toDate" />
                </div>

                <!-- Work Order – searchable select -->
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <label class="form-label fw-bold small mb-1">
                        <i class="fas fa-clipboard-list text-secondary"></i> Work Order
                    </label>
                    <select id="selWorkOrder" name="workOrder" class="form-select form-select-sm" autocomplete="off">
                        <option value="">-- Tất cả --</option>
                        @foreach (var w in allWorkOrders)
                        {
                            if (w == workOrder)
                            {
                                <option value="@w" selected="selected">@w</option>
                            }
                            else
                            {
                                <option value="@w">@w</option>
                            }
                        }
                    </select>
                </div>

                <!-- Operation – searchable select -->
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <label class="form-label fw-bold small mb-1">
                        <i class="fas fa-cogs text-secondary"></i> Operation
                    </label>
                    <select id="selOperation" name="operation" class="form-select form-select-sm" autocomplete="off">
                        <option value="">-- Tất cả --</option>
                        @foreach (var op in allOperations)
                        {
                            if (op == operation)
                            {
                                <option value="@op" selected="selected">@op</option>
                            }
                            else
                            {
                                <option value="@op">@op</option>
                            }
                        }
                    </select>
                </div>

                <!-- Defect Code – searchable select -->
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <label class="form-label fw-bold small mb-1">
                        <i class="fas fa-exclamation-circle" style="color:#d69e2e"></i> Defect Code
                    </label>
                    <select id="selDefectCode" name="defectCode" class="form-select form-select-sm" autocomplete="off">
                        <option value="">-- Tất cả --</option>
                        @foreach (var dc in allDefectCodes)
                        {
                            var dname  = allDefectNames.ContainsKey(dc) ? allDefectNames[dc] : "";
                            var dlabel = string.IsNullOrEmpty(dname) ? dc : $"{dc} - {dname}";
                            if (dc == defectCode)
                            {
                                <option value="@dc" selected="selected">@dlabel</option>
                            }
                            else
                            {
                                <option value="@dc">@dlabel</option>
                            }
                        }
                    </select>
                </div>

                <!-- Bản ghi/trang -->
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <label class="form-label fw-bold small mb-1">
                        <i class="fas fa-list"></i> Bản ghi/trang
                    </label>
                    <select class="form-select form-select-sm" name="pageSize">
                        @foreach (var ps in pageSizeOptions)
                        {
                            if (ps == pageSize)
                            {
                                <option value="@ps" selected="selected">@ps bản ghi</option>
                            }
                            else
                            {
                                <option value="@ps">@ps bản ghi</option>
                            }
                        }
                    </select>
                </div>

                <!-- Buttons -->
                <div class="col-12 col-md-6 col-lg-4 d-flex gap-2 flex-wrap filter-btns">
                    <button type="submit" class="btn-filter-apply flex-fill" style="min-width:120px">
                        <i class="fas fa-search me-1"></i> Lọc dữ liệu
                    </button>
                    <a href="@Url.Action("Report")" class="btn-filter-clear flex-fill" style="min-width:100px; justify-content:center;">
                        <i class="fas fa-times"></i> Xóa lọc
                    </a>
                </div>

            </div>
        </form>
    </div>

    @if (totalRecords > 0)
    {
        <!-- ===== KPI ===== -->
        <div class="row g-3 mb-1 fade-up-3">
            <div class="col-12 col-sm-4">
                <div class="stats-card kpi-blue">
                    <h5><i class="fas fa-cogs me-1" style="color:#2a5298"></i>Tổng số Operation</h5>
                    <h2 style="color:#2a5298">@ViewBag.TotalOperations</h2>
                </div>
            </div>
            <div class="col-12 col-sm-4">
                <div class="stats-card kpi-danger">
                    <h5><i class="fas fa-list-alt me-1 text-danger"></i>Tổng Defect Records</h5>
                    <h2 class="text-danger">@ViewBag.TotalRecords</h2>
                </div>
            </div>
            <div class="col-12 col-sm-4">
                <div class="stats-card kpi-warning">
                    <h5><i class="fas fa-times-circle me-1" style="color:#d69e2e"></i>Tổng số lượng NG</h5>
                    <h2 style="color:#d69e2e">@ViewBag.TotalQtyNG</h2>
                </div>
            </div>
        </div>

        <!-- ===== EXPORT ===== -->
        <div class="mb-3 text-end">
            <a href="@Url.Action("ExportDefectReport", new {
                fromDate  = fromDate,  toDate    = toDate,
                workOrder = workOrder, operation = operation,
                defectCode = defectCode, itemCode = itemCode
            })" class="btn-export">
                <i class="fas fa-file-excel"></i> Xuất Excel
            </a>
        </div>

        <!-- ===== CHARTS ROW 1 ===== -->
        <div class="row g-3">
            <div class="col-12 col-md-6 col-xl-4">
                <div class="chart-box">
                    <h4><i class="fas fa-chart-bar me-1" style="color:#2a5298"></i>Biểu đồ Defect theo operation</h4>
                    <canvas id="operationChart"></canvas>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-4">
                <div class="chart-box">
                    <h4><i class="fas fa-chart-bar me-1 text-danger"></i>Biểu đồ Pareto Defect theo tên lỗi</h4>
                    <canvas id="paretoChart"></canvas>
                </div>
            </div>
            <div class="col-12 col-md-12 col-xl-4">
                <div class="chart-box">
                    <h4><i class="fas fa-chart-pie me-1 text-success"></i>Biểu đồ Top 10 Operation nhiều lỗi nhất</h4>
                    <canvas id="pieChart"></canvas>
                </div>
            </div>
        </div>

        <!-- ===== CHART TREND ===== -->
        <div class="row">
            <div class="col-12">
                <div class="trend-box">
                    <h4>
                        <i class="fas fa-chart-line me-1 text-info"></i> Defect Trend theo ngày
                        <small class="text-muted fw-normal">&nbsp;— Moving Avg 7 ngày</small>
                    </h4>
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>

        <!-- ===== DETAIL TABLE ===== -->
        <div class="card-box">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <h5 class="mb-0" style="color:#2d3748">
                    <i class="fas fa-table me-1" style="color:#2a5298"></i> Chi tiết Defect Records
                    <span class="badge ms-1" style="background:#2a5298">@totalRecords bản ghi</span>
                </h5>
                <span class="text-muted small">Trang @currentPage / @totalPages</span>
            </div>

            <div class="table-responsive" style="max-height:520px; overflow-y:auto;">
                <table class="table table-bordered table-hover table-defect mb-0" id="defectTable">
                    <thead>
                        <tr>
                            <th style="width:38px" class="sortable" onclick="sortTable(0,this)">#<span class="sort-icon">⇅</span></th>
                            <th class="sortable" onclick="sortTable(1,this)">Work Order<span class="sort-icon">⇅</span></th>
                            <th class="sortable col-sm-hide" onclick="sortTable(2,this)">Item Code<span class="sort-icon">⇅</span></th>
                            <th class="sortable" onclick="sortTable(3,this)">Defect Code<span class="sort-icon">⇅</span></th>
                            <th class="sortable" onclick="sortTable(4,this)">Defect Name<span class="sort-icon">⇅</span></th>
                            <th class="sortable text-center" style="width:68px" onclick="sortTable(5,this)">Qty NG<span class="sort-icon">⇅</span></th>
                            <th class="sortable" onclick="sortTable(6,this)">Operation<span class="sort-icon">⇅</span></th>
                            <th class="col-sm-hide">Employer</th>
                            <th class="col-sm-hide">Note</th>
                            <th class="text-center" style="width:58px">Image</th>
                            <th class="sortable" onclick="sortTable(10,this)">Time Line<span class="sort-icon">⇅</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = (currentPage - 1) * pageSize + 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr onclick="showDetail(@item.Id)" data-id="@item.Id">
                                <td class="text-center text-muted small">@stt</td>
                                <td class="text-nowrap">
                                    <small class="fw-semibold" style="color:#2d3748">@item.Work_order</small>
                                </td>
                                <td class="col-sm-hide">
                                    <small class="text-muted">@item.Item_code</small>
                                </td>
                                <td>
                                    <span class="badge-dc">@item.Defect_Code</span>
                                </td>
                                <td style="color:#2d3748">@item.Defect_Name</td>
                                <td class="text-center fw-bold" style="color:#e53e3e; font-size:13px">@item.Qty_NG</td>
                                <td>
                                    <span class="badge-op">@item.Operation</span>
                                </td>
                                <td class="col-sm-hide">
                                    <small class="d-block fw-semibold" style="color:#4a5568">@item.Employer_code</small>
                                    <small class="text-muted">@item.Employer_name</small>
                                </td>
                                <td class="col-sm-hide">
                                    @if (!string.IsNullOrEmpty(item.Note))
                                    {
                                        <span class="text-muted small" title="@item.Note">
                                            @(item.Note.Length > 35 ? item.Note.Substring(0, 35) + "…" : item.Note)
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.Image_error))
                                    {
                                        <img src="@item.Image_error" class="img-thumb"
                                             onclick="event.stopPropagation(); showImage('@item.Image_error')"
                                             onerror="this.style.display='none'" alt="img" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <small class="d-block" style="color:#4a5568">@item.Time_line?.ToString("dd/MM/yyyy")</small>
                                    <small class="text-muted">@item.Time_line?.ToString("HH:mm:ss")</small>
                                </td>
                            </tr>
                            stt++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- ===== PAGINATION ===== -->
            @if (totalPages > 1)
            {
                <div class="mt-3">
                    <nav>
                        <ul class="pagination pagination-sm justify-content-center flex-wrap gap-1 mb-1">
                            <li class="page-item @(!hasPrevPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Report", new { page = 1, pageSize, fromDate, toDate, workOrder, operation, defectCode, itemCode })">
                                    <i class="fas fa-angle-double-left"></i>
                                </a>
                            </li>
                            <li class="page-item @(!hasPrevPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Report", new { page = currentPage - 1, pageSize, fromDate, toDate, workOrder, operation, defectCode, itemCode })">
                                    <i class="fas fa-angle-left"></i>
                                </a>
                            </li>
                            @{
                                int startPage = Math.Max(1, currentPage - 3);
                                int endPage   = Math.Min(totalPages, currentPage + 3);
                            }
                            @for (int p = startPage; p <= endPage; p++)
                            {
                                int pCopy = p;
                                <li class="page-item @(pCopy == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Report", new { page = pCopy, pageSize, fromDate, toDate, workOrder, operation, defectCode, itemCode })">@pCopy</a>
                                </li>
                            }
                            <li class="page-item @(!hasNextPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Report", new { page = currentPage + 1, pageSize, fromDate, toDate, workOrder, operation, defectCode, itemCode })">
                                    <i class="fas fa-angle-right"></i>
                                </a>
                            </li>
                            <li class="page-item @(!hasNextPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Report", new { page = totalPages, pageSize, fromDate, toDate, workOrder, operation, defectCode, itemCode })">
                                    <i class="fas fa-angle-double-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <p class="text-center text-muted small mb-0">
                        Hiển thị @((currentPage - 1) * pageSize + 1) – @Math.Min(currentPage * pageSize, totalRecords)
                        trong tổng số @totalRecords bản ghi
                    </p>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-inbox fa-4x text-muted mb-3 d-block"></i>
            <p class="text-muted fs-5">Không có dữ liệu. Vui lòng điều chỉnh bộ lọc và thử lại.</p>
        </div>
    }

</div>

